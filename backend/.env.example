SECRET_KEY=
DEBUG=True
ENV=development
# Local dev — use manohiti / localhost. Railway production DB vars go in Railway
# dashboard (or backend/.env.railway for reference). Do not put postgres.railway.internal here.
ALLOWED_HOSTS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TIMEOUT=20
# Production recommended: use an HTTP email provider because Railway may block or
# time out direct Gmail SMTP. Supported values: smtp, brevo, resend.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=Manohiti
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
THERAPIST_EMAIL=heti3215@gmail.com
SESSION_PRICE=0
FRONTEND_URL=http://localhost:3000

# WhatsApp (Meta Cloud API) — disabled by default until credentials are configured
WHATSAPP_ENABLED=False
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
THERAPIST_WHATSAPP_NUMBER=
